{
  "name": "dsh-yu-memory",
  "version": "2.0.0",
  "description": "DSH 统一记忆：跨会话长期记忆、会淡忘的对话记忆，以及连线即上下文的非线性记忆图。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Speraymer/dsh-yu-memory.git"
  },
  "homepage": "https://github.com/Speraymer/dsh-yu-memory#readme",
  "bugs": {
    "url": "https://github.com/Speraymer/dsh-yu-memory/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "graph-app",
    "lib",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "external": [
        "react"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-attachment": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-web": ">=0.1.7-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-web": {
      "optional": true
    }
  }
}
